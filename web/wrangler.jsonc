{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirai-anime-studio",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-25",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
